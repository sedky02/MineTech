NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://minetech:minetech@localhost:5433/minetech?schema=public

# Long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend origins (never "*")
CORS_ORIGIN=http://localhost:3000

# Questions created before this instant are tagged PRE_EVENT, after it LIVE
EVENT_STARTS_AT=2026-11-15T14:00:00+01:00

# Used by `npm run db:seed` to create internal accounts (optional)
SEED_MODERATOR_USERNAME=moderator
SEED_MODERATOR_PASSWORD=
SEED_HOST_USERNAME=host
SEED_HOST_PASSWORD=
