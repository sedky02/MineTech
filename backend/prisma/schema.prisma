generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MODERATOR
  HOST
}

enum QuestionStatus {
  PENDING
  MODERATOR_APPROVED
  REJECTED
  HOST_APPROVED
  DISPLAYED
  ANSWERED
}

enum QuestionSource {
  PRE_EVENT
  LIVE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Question {
  id                   String         @id @default(uuid()) @db.Uuid
  /// Topic slug from the fixed list in src/common/categories.ts (CHECK
  /// constraint in the static_categories migration).
  category             String         @db.VarChar(32)
  content              String         @db.VarChar(500)
  displayName          String?        @map("display_name") @db.VarChar(50)
  participantSessionId String         @map("participant_session_id") @db.Uuid
  source               QuestionSource
  status               QuestionStatus @default(PENDING)
  /// Order within the question's current list (lower = first). Set to the
  /// current time when a question enters a list; moderators reorder by
  /// swapping positions.
  position             Float          @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  moderatorApprovedAt DateTime? @map("moderator_approved_at")
  moderatorRejectedAt DateTime? @map("moderator_rejected_at")

  hostApprovedAt DateTime? @map("host_approved_at")
  hostRejectedAt DateTime? @map("host_rejected_at")

  displayedAt DateTime? @map("displayed_at")
  answeredAt  DateTime? @map("answered_at")
  /// Last time a rejected or answered question was sent back to review.
  returnedToReviewAt DateTime? @map("returned_to_review_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, position])
  @@index([participantSessionId, createdAt])
  @@map("questions")
}

// Single-row table (id is always 1) holding global event state.
model EventState {
  id               Int       @id @default(1)
  submissionsOpen  Boolean   @default(true) @map("submissions_open")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("event_state")
}
