# Backend URLs (Render in production). Only NEXT_PUBLIC_* variables reach the browser: never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Branding
NEXT_PUBLIC_EVENT_NAME=MineTech
NEXT_PUBLIC_CLUB_NAME=
# Shown on the idle presentation screen, e.g. minetech.vercel.app
NEXT_PUBLIC_PARTICIPANT_URL=
